# ---------------------------------------------------------------------------
# Copia este archivo como .env.local y llena los valores reales.
# .env.local NO se versiona. Nunca pegues estas llaves en el chat ni en el repo.
# ---------------------------------------------------------------------------

# Supabase self-hosted (Dokploy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de la API key del LLM (AES-256-GCM). 32 bytes en base64.
# Respáldala fuera de la base: si se pierde, la API key guardada es irrecuperable.
CRM_ENCRYPTION_KEY=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# URL pública de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000
